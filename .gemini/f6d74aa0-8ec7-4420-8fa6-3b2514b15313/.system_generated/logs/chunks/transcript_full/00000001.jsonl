a;\n115:         g_free(p->name);\n116:         if (p->type == USB_PROP_ARRAY) g_free(p->val.array);\n117:         if (p->type == USB_PROP_NODE) free_node(p->val.node);\n118:         g_free(p);\n119:     }\n120:     g_list_free(node->props);\n121:     g_free(node);\n122: }\n123: \n124: // --- Execution Example ---\n125: \n126: int main() {\n127:     // 1. Build the Endpoint Descriptor (Nested level 2)\n128:     UsbNode *ep_node = create_node();\n129:     ep_node->props = g_list_append(ep_node->props, create_prop_u8(\"bLength\", 7));\n130:     ep_node->props = g_list_append(ep_node->props, create_prop_u8(\"bDescriptorType\", 0x05));\n131:     ep_node->props = g_list_append(ep_node->props, create_prop_u8(\"bEndpointAddress\", 0x81));\n132:     ep_node->props = g_list_append(ep_node->props, create_prop_u8(\"bmAttributes\", 0x03));\n133:     ep_node->props = g_list_append(ep_node->props, create_prop_u16(\"wMaxPacketSize\", 8));\n134:     ep_node->props = g_list_append(ep_node->props, create_prop_u8(\"bInterval\", 10));\n135: \n136:     // 2. Build the Interface Descriptor (Nested level 1)\n137:     UsbNode *if_node = create_node();\n138:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bLength\", 9));\n139:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bDescriptorType\", 0x04));\n140:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bInterfaceNumber\", 0));\n141:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bAlternateSetting\", 0));\n142:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bNumEndpoints\", 1));\n143:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bInterfaceClass\", 0x03)); // HID\n144:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bInterfaceSubClass\", 0x01));\n145:     if_node->props = g_list_append(if_node->props, create_prop_u8(\"bInterfaceProtocol\", 0x01));\n146:     if_node->props = g_list_append(if_node->pr